// VSCode workspace settings – prevents auto-format of query.md on save.
//
// NOTE: VSCode has no native per-file `editor.formatOnSave` exclusion,
// only per-language. So we do two layers:
//   1. Disable format-on-save/paste for markdown here (all *.md).
//   2. Use `.prettierignore` + `.markdownlintignore` for single-file
//      granularity, so `query.md` stays untouched even on manual format.
{
  // Keep format-on-save ON for everything else
  "editor.formatOnSave": true,

  // Disable for markdown (covers query.md)
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.defaultFormatter": null
  },

  // Don't run markdownlint fixes on save for markdown
  "editor.codeActionsOnSave": {
    "source.fixAll.markdownlint": "never"
  },

  // If you use Prettier extension, make sure it respects .prettierignore
  "prettier.requireConfig": false,
  "prettier.ignorePath": ".prettierignore"

  // OPTIONAL single-file-only alternative (keeps other *.md formatting ON):
  // Uncomment below to treat query.md as plaintext so no markdown
  // formatter ever touches it, then you can remove the "[markdown]" block above.
  // "files.associations": {
  //   "query.md": "plaintext"
  // }
}
